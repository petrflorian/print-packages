<Window x:Class="PrintPackages.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tiskové balíčky" Height="620" Width="1040" MinHeight="460" MinWidth="760">
  <DockPanel Margin="18">
    <ToolBar DockPanel.Dock="Top">
      <Button Click="New_Click" Padding="12,4">Nový balíček</Button>
      <Button Click="NewFolder_Click" Padding="12,4">Nová složka</Button>
      <Button Click="Import_Click" Padding="12,4">Import</Button>
      <Separator />
      <Button Click="Export_Click" Padding="12,4">Export</Button>
      <Button Click="Copy_Click" Padding="12,4">Kopie</Button>
      <Button Click="Rename_Click" Padding="12,4">Přejmenovat</Button>
      <Button Click="Move_Click" Padding="12,4">Přesunout</Button>
      <Button Click="Delete_Click" Padding="12,4">Smazat</Button>
      <Separator />
      <TextBox x:Name="SearchBox" Width="210" TextChanged="Search_Changed" ToolTip="Hledat" />
    </ToolBar>
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Složky" FontWeight="SemiBold" Margin="4,2,4,8" />
          <TreeView x:Name="Folders" SelectedItemChanged="Folders_SelectionChanged" />
        </DockPanel>
      </Border>
      <ListBox Grid.Column="2" x:Name="Packages" SelectionChanged="Packages_SelectionChanged" DisplayMemberPath="DisplayName" />
      <Border Grid.Column="4" BorderBrush="#D0D0D0" BorderThickness="1" Padding="16">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="Detail balíčku" FontSize="20" FontWeight="SemiBold" />
            <Border x:Name="PrinterBadge" DockPanel.Dock="Right" Background="#555" CornerRadius="12" Padding="10,4" Visibility="Collapsed">
              <TextBlock x:Name="PrinterBadgeText" Foreground="White" FontWeight="SemiBold" />
            </Border>
          </DockPanel>
          <Image x:Name="Preview" Height="250" Stretch="Uniform" Margin="0,14,0,10" />
          <TextBlock x:Name="Details" TextWrapping="Wrap" />
          <TextBlock Text="Poznámka" FontWeight="SemiBold" Margin="0,16,0,4" />
          <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />
          <Button Click="SaveNote_Click" HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0">Uložit poznámku</Button>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <TextBlock Text="Počet kopií:" VerticalAlignment="Center"/>
            <TextBox x:Name="CopiesBox" Width="48" Text="1" Margin="8,0" />
            <Button Click="Print_Click" Padding="18,5">Vytisknout</Button>
            <Button Click="PrintAgain_Click" Padding="12,5" Margin="8,0,0,0">Tisknout znovu (1)</Button>
            <Button x:Name="FavoriteButton" Click="Favorite_Click" Padding="12,5" Margin="8,0,0,0">☆ Oblíbené</Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
